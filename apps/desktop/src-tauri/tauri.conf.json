{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chief Observatory",
  "version": "0.1.0",
  "identifier": "dev.chief.observatory",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Chief Observatory",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src http://127.0.0.1:4174; frame-src http://127.0.0.1:4174; img-src 'self' data: http://127.0.0.1:4174; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [],
    "externalBin": ["binaries/chiefd"],
    "category": "DeveloperTool",
    "shortDescription": "Observe coding-agent work across projects"
  }
}
