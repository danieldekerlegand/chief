#!/usr/bin/env bash
# chief — autonomous tasklist runner (worktree-isolated, dependency/conflict-aware).
set -uo pipefail

# Resolve this script through any symlink chain FIRST — install.sh links a shim
# (e.g. ~/.local/bin/chief -> ~/.chief/src/bin/chief), and an unresolved
# BASH_SOURCE would point $SELF at the bindir's parent, not the real tool root,
# breaking $ENGINE/$TEMPLATES/$VERSION on every installed run.
_src="${BASH_SOURCE[0]}"
while [ -h "$_src" ]; do
  _dir="$(cd -P "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  case "$_src" in /*) ;; *) _src="$_dir/$_src" ;; esac
done
SELF="$(cd -P "$(dirname "$_src")/.." && pwd)"             # tool root: <root>/bin/chief
unset _src _dir
ENGINE="$SELF/engine"
TEMPLATES="$SELF/templates"
VERSION="$(cat "$SELF/VERSION" 2>/dev/null || echo unknown)"
# Host-wide state paths, resolved in ONE place (engine/paths.sh) because $HOME is
# not a given: in a container it may be unset (an unguarded `$HOME` under `set -u`
# is a fatal error, not a default) or read-only. See that file for the fallbacks.
# shellcheck source=engine/paths.sh
. "$ENGINE/paths.sh"
# git-as-a-container-hands-it-to-us (ownership + committer identity). Only the probe
# is used here — the driver is what SETS anything; `chief init` merely needs to tell
# "this is not a git repo" apart from "git refuses to look at this repo".
# shellcheck source=engine/gitenv.sh
. "$ENGINE/gitenv.sh"
# Host-wide run registry (shared by every repo). The driver drops a <pid>.run
# file here per active run; `chief ps`/`chief monitor` read it. Overridable via
# CHIEF_RUNS; defaults under the install prefix (~/.chief).
CHIEF_RUNS="$(chief_runs_dir)"
# Known-repos registry: every repo `chief` has touched (init or run), one absolute
# path per line. The desktop UI reads this to list repos for history + new tasklists
# (active runs already self-register in CHIEF_RUNS). Deduped, best-effort.
CHIEF_REPOS="$(chief_repos_dir)"
# CHIEF_PREFIX is exported as the RESOLVED value so the whole process tree (driver,
# agents, a nested `chief` an agent runs) agrees on one prefix even when it came from
# a fallback — two processes re-deriving it from a differing environment would
# otherwise split the registry in half.
CHIEF_PREFIX="$(chief_prefix)"
export CHIEF_RUNS CHIEF_REPOS CHIEF_PREFIX

register_repo() {   # $1 = absolute repo root; append if not already present
  local root="$1" dir; dir="$(dirname "$CHIEF_REPOS")"
  [ -n "$root" ] || return 0
  mkdir -p "$dir" 2>/dev/null || return 0
  [ -f "$CHIEF_REPOS" ] && grep -qxF "$root" "$CHIEF_REPOS" 2>/dev/null && return 0
  printf '%s\n' "$root" >> "$CHIEF_REPOS" 2>/dev/null || true
}

usage() {
  cat <<EOF
chief $VERSION — autonomous tasklist runner (worktree-isolated, dep/conflict-aware).

Usage:
  chief init                  scaffold .chief/ + tasks/chief/ in the current repo
  chief status [--blocked]    what is LEFT and what can START NOW — remaining (live/parked),
        [--all] [--json]      runnable vs blocked on an unmerged dependency, completed, problems.
        [--enforce-order]     --blocked names the edge holding each one, and ranks the merges
                              that would release the most: a plan, not a number. --json emits the
                              whole report as ONE document on stdout (notes on stderr). Run inside a repo it
                              reports that repo; run ABOVE several it walks the tree and reports
                              a per-repo table plus portfolio totals; --all reports every repo in
                              the known-repos registry regardless of cwd. The header always states
                              which scope produced the numbers. Breaks the totals down by the
                              tasklist's "category" — an OPAQUE string chief reports and never
                              ranks, unless the project declared its own ordering in .chief/config —
                              and breaks the PARKED total down by "parkedReason" on the same terms.
                              Always exits 0; only --enforce-order, opt-in for CI, can exit non-zero
  chief gen ROADMAP.json      generate tasklists from a roadmap document — one schema-valid
                              tasks/chief/NN-slug.json per roadmap item, numbered in the next
                              free band, with branchName/dependsOn/touches per the conventions.
                              The programmatic way for an embedding host to author tasklists.
                              -n/--dry-run emits NDJSON to stdout and writes nothing; --force
                              overwrites; --out DIR stages elsewhere. An unknown roadmap field
                              is an error (--allow-unknown warns instead). Input contract
                              (phases[] → items[] with title/description required and scope/
                              deps/touches/iters optional): docs/reference/roadmap-input.md
  chief lint [names…]         check this repo's tasklists BEFORE a run spends turns on them:
                              valid JSON, branchName == chief/<filename stem>, no mergedToMain
                              on unmerged work, and no acceptance criterion naming work in
                              ANOTHER repo (which the tasklist's worktree cannot reach — declare
                              it with "crossRepo":["<repo>"] when the coordination is real).
                              No args = every tasklist in the tasks dir. Non-zero on any finding.
  chief run [-p N] [names…]   run pending tasklists (default sequential; -p N = concurrency)
                              --provider claude|devin|opencode|amp|codex (default claude)
                              --model MODEL (provider-specific model override; amp has no
                              model selector, so --model is refused for it)
                              --claude, --devin, --opencode, --amp, --codex provider shortcuts
                              --preset local (= --local) cost-avoidance mode: run every agent
                              turn on a LOCAL/self-hosted endpoint via opencode, at zero API
                              cost and materially lower coding quality. Configure it with
                              CHIEF_LOCAL_ENDPOINT + CHIEF_LOCAL_MODEL (env or .chief/config);
                              unconfigured it errors instead of falling back to a paid
                              provider. See docs/guides/local-inference-preset.md
                              --parked run a PARKED tasklist you named anyway. Without it,
                              naming a parked tasklist prints the reason it carries
                              ("parkedReason") and schedules nothing
  chief list [-a|--all]       list live tasklists with state, progress, category and reason;
                              -a/--all includes completed tasklists; --plain is stable TSV
  chief ps [-a|--all]         show active runs across ALL repos; -a also shows every non-done
                              tasklist in the current repo. Also flags an
                              UNREGISTERED driver — one that is running with no run file, which
                              used to read as 'no active runs' — naming its repo, the tasklists
                              in flight, and the pid to kill.
  chief monitor [-a|--all] [interval] live-refresh that view (default 2s; Ctrl-C to exit)
  chief logs [name] [-f]      hook into a live run's output — tail a tasklist's per-iteration log
                              (the agent's stdout, gate output, stall notes). Defaults to the
                              running tasklist; -f/--follow streams it live, -n N sets the tail size
  chief events [run-id] [-f]  subscribe to a run's machine-readable EVENT STREAM — the append-only
                              NDJSON log of run/tasklist/story transitions
                              ($CHIEF_RUNS/<run-id>.events.jsonl). Defaults to the live run (else the
                              most recent log); -f/--follow streams events as they land, -l/--list
                              enumerates the logs on this host, -n N starts N lines back. stdout is
                              pure NDJSON (pipe it to jq) — notes go to stderr. This is the contract
                              chief-cloud and embedding hosts read: docs/reference/events.md
  chief usage [--days N]      report turns, provider usage, and rate-limit incidents from the
       [--repo PATH] [--json] existing event logs; --json emits one machine-readable document
  chief models [provider]     list the models you can pass to --model: live from the provider for
                              devin/opencode, the stable family aliases for claude, none for amp/codex
                              (no arg = all)
  chief reap [-n] [--grace N] stop ORPHANED chief processes, of BOTH kinds. First agent
       [--scope PREFIX]       WORK — agent trees still running (and still spending quota)
                              with no live, registered run behind them. Then abandoned
                              VIEWS — \`chief monitor\` watchers that outlived the terminal
                              that asked for them; reported SEPARATELY, because ending a
                              view costs a redraw and ending an agent tree costs a run.
                              -n reports without signalling. HOST-WIDE by default:
                              every repo on this box, not just the one you are in —
                              --scope <repo>-<cksum>- narrows it to one repo's runs (a
                              view belongs to no run, so it is never narrowed).
                              Never touches a live run, a watcher whose terminal is
                              still open, another user's processes, or your own claude
                              sessions. Then the DISK half: build
                              directories (target/ node_modules/ .venv/ build/) left
                              behind in worktrees with no live run and idle past
                              --disk-age (default 1h). --no-disk / --disk-only pick
                              one half; a shared cache or a symlink out is refused.
  chief quality SUB [opts]    the code-quality RATCHET — the merge gate's second, MEASURED axis.
                              \`measure\` emits a deterministic metric record (size · complexity ·
                              duplication · decomposition · lint violations) for a file set;
                              \`ratchet\` compares the branch against \$CHIEF_BASE_BRANCH and exits
                              non-zero when a tracked metric regressed past its tolerance, so a
                              verify hook can BLOCK a merge that made the codebase measurably
                              worse even with every test green. No model judgment anywhere in it
                              — awk over text, offline, byte-identical output. Configure per repo
                              in .chief/quality.conf; \`--write-baseline\` is the reviewable
                              re-baseline hatch; CHIEF_VERIFY_QUALITY=0 skips it.
                              See docs/reference/verify-hook.md
  chief cigate [-a] [-v]      DID THE DECLARED CI GATE ACTUALLY RUN? A report, never a block.
       [--head|--sha SHA]     Per repo, the state of the most recent run of every workflow it
       [paths…]               DECLARES: RAN AND PASSED · RAN AND FAILED · DID NOT RUN (no run
                              ever, a run that completed without executing a single step, or a
                              green run that never covered the commit asked about). A repo with
                              no workflows is not flagged. OFFLINE-SAFE: no gh, no remote or no
                              network is UNKNOWN — stated as unknown, never rounded to a pass.
                              -a all known repos · -v also the healthy · always exits 0
  chief approve [names…]      release a branch HELD AT AN OVERLAP ZONE — a domain this repo
       [--list] [-m NOTE]     declared in .chief/zones.conf as one where a green gate is not
                              sufficient authority to merge. The branch is already rebased onto
                              the base and verified GREEN; what you are approving is the thing no
                              gate can check — that its design agrees with what else landed. The
                              verdict is durable and bound by checksum to the change it approved,
                              so a restart never re-asks. No name (or --list) reports what is
                              waiting. See docs/reference/overlap-zones.md
  chief decide NAME VERDICT  record the operator's verdict with --note NOTE, then
       [--retire ID]          retire it to completed/ (without mergedToMain), or
       [--unpark]             clear its park while retaining the verdict.
  chief retire --negative     retire a tasklist whose delivered stories PASSED and whose remaining
       NAME [-n] [--no-commit] story TERMINATED FALSE — declared "terminalFalse" and carrying the
                              measurement behind the answer. Files the completed/ record (the
                              negative keeps its \`false\` and its finding, plus a
                              "retiredOnNegative" block a successor tasklist can cite) and stops
                              the tasklist being scheduled. REFUSES a tasklist whose stories are
                              merely unfinished, one whose declaration recorded no measurement,
                              and — when the work never reached the base branch — one that live
                              tasklists still depend on. -n reports the verdict and writes nothing
  chief pause [--all]         withhold AGENT TURNS: launch no tasklist and start no new agent
                              iteration — but DRAIN, never kill: the iteration in flight runs to
                              completion so its commits land, a tasklist whose agent loop already
                              finished still verifies + merges, and the rest park as 'paused' with
                              branch and worktree kept. --all = every run in the registry.
  chief resume [--all]        lift the pause and re-arm parked tasklists as pending, so the next
                              'chief run' RESUMEs each from its committed passes state. An armed
                              usage-limit window is a separate hold and is NOT lifted.
  chief version               print the version
  chief update                self-update the installed engine (hard-reset to origin; CHIEF_VERSION pins a tag)
  chief help                  this message

run flags:
  -p, --parallel N   run up to N tasklists at once (default 1) — also settable as PARALLEL=N
                     in the environment; the flag wins, and omitting it leaves PARALLEL alone
  -n, --dry-run      print the schedule and exit (no git, no agents) — also settable as
                     DRY_RUN=1 in the environment, which \`chief run\` honours rather than
                     overriding it with a real run
  -V, --verbose      trace each provider invocation into the log (provider · model · prompt) —
                     also settable as CHIEF_VERBOSE=1 in the environment or .chief/config
      --headless     non-interactive/programmatic mode for a host app embedding chief: no ANSI
                     colour, no interactive step, line-oriented output, and the run announces its
                     id on a greppable \`chief: run-id=<id>\` line before the loop starts, ends with
                     a one-line JSON \`chief: summary=…\`, and EXITS with a code that names the
                     outcome (0 merged · 2 config · 3 no-work · 4 verify-failed · 5 conflict ·
                     6 failed · 7 held). Takes all the flags/env above unchanged. Also settable as
                     CHIEF_HEADLESS=1. Never inferred from stdout being a pipe — the whole
                     contract is docs/guides/headless-invocation.md
      --account-env FILE
                     run this tasklist's AGENT TURNS under a designated provider account: a
                     KEY=VALUE env file (e.g. CLAUDE_CONFIG_DIR=… or ANTHROPIC_API_KEY=…)
                     applied around the provider invocation ONLY — git, the verify hook and
                     the iteration hooks keep chief's own environment. A file so secrets never
                     reach argv; unreadable = a launch error, never a silent fall-back to the
                     inherited account. Also settable as CHIEF_ACCOUNT_ENV_FILE (environment or
                     .chief/config). Chief designates ONE account per run and does no pooling.
      --account-label NAME
                     the name this run's account is REPORTED under — in \`chief ps\`/\`chief monitor\`,
                     the run registry and the run.started event — so an operator can see which
                     account a run spends without any surface carrying its secrets. Defaults to the
                     --account-env file's basename. Also settable as CHIEF_ACCOUNT_LABEL.
      --merge-batch[=N]
                     OPT-IN MERGE QUEUE: batch up to N merge-ready branches, stack them on the
                     base and verify the batch TIP ONCE instead of paying the verify gate once
                     per branch. Bare flag = 4; =1 is the serialized floor (i.e. off). DEFAULT
                     OFF — without it the merge phase is the rebase -> re-verify -> --no-ff
                     floor it has always been, which stays chief's correctness guarantee.
                     Merges are still --no-ff, one commit per tasklist, still serialized against
                     the base; only the VERIFICATION is amortized. A branch that carries its own
                     "verify" array, or that changes a \`review\` overlap zone, is never batched.
                     A RED batch tip names no culprit, so it is BISECTED: binary-search the
                     stacked prefixes for the smallest failing one, confirm that branch by
                     re-verifying it ALONE, blame it (VERIFY-FAILED, exactly as a serialized
                     failure would), merge the prefix the search proved green, and re-form a
                     batch from the survivors. If the confirming run DISAGREES with the bisect
                     — a flaky gate, or a failure that is joint rather than one branch's — the
                     bisect is abandoned and the whole batch takes the floor.
                     Also settable per repo as CHIEF_MERGE_BATCH in .chief/config; a leader waits
                     CHIEF_MERGE_BATCH_WAIT seconds (default 120) for peers to finish before it
                     closes a batch, and CHIEF_MERGE_BATCH_BISECT (default 2, 0 = never bisect)
                     bounds how many branches one red batch may isolate before it dissolves to
                     the floor. Needs -p N > 1 to have anything to batch.
                     See docs/explanation/drivers-and-safety.md
      --no-merge     complete branches but don't merge into the base

pause/resume flags:
  -a, --all          apply to every run in the host-wide registry (path below) — sibling repos
                     share one account, so the quota decision is usually fleet-wide. Both commands
                     are idempotent (exit 0 on a no-op) and never touch the usage-limit self-heal.

Project config: <repo>/.chief/config   ·   Run registry: $CHIEF_RUNS   ·   Docs: $SELF/docs/
EOF
}

find_project() {
  local d="$PWD"
  while [ "$d" != "/" ]; do
    [ -f "$d/.chief/config" ] && { echo "$d"; return 0; }
    d="$(dirname "$d")"
  done
  return 1
}

load_project() {
  CHIEF_PROJECT="$(find_project)" || { echo "ERROR: no .chief/config found from $PWD upward. Run 'chief init' first." >&2; exit 1; }
  register_repo "$CHIEF_PROJECT"
  # defaults (a project's .chief/config may override any of these)
  CHIEF_TOOL=claude; CHIEF_PROVIDER=claude; CHIEF_MODEL=""
  CHIEF_TASKS_DIR=tasks/chief; CHIEF_STATE_DIR=.chief/state
  CHIEF_VERIFY=.chief/verify.sh; CHIEF_AGENT_CONTEXT=.chief/agent-context.md
  CHIEF_AUTO_MERGE=1; CHIEF_BASE_BRANCH=main
  CHIEF_PRESET="${CHIEF_PRESET:-}"   # named provider·model·endpoint bundle (engine/preset.sh)
  # shellcheck disable=SC1091
  source "$CHIEF_PROJECT/.chief/config"
  # CHIEF_TOOL is the pre-provider compatibility name. Preserve configurations
  # that selected a non-default tool while making provider the canonical setting.
  if [ "${CHIEF_PROVIDER:-claude}" = claude ] && [ "${CHIEF_TOOL:-claude}" != claude ]; then
    CHIEF_PROVIDER="$CHIEF_TOOL"
  fi
  CHIEF_HOME="$ENGINE"
  export CHIEF_PROJECT CHIEF_HOME CHIEF_TOOL CHIEF_PROVIDER CHIEF_MODEL CHIEF_PRESET \
         CHIEF_TASKS_DIR CHIEF_STATE_DIR CHIEF_VERIFY CHIEF_AGENT_CONTEXT \
         CHIEF_AUTO_MERGE CHIEF_BASE_BRANCH
  # PLAN REVIEW (docs/plan-review.md). Exported — not merely sourced — so a repo that
  # opts into the checkpoint can name its reviewer and its window in .chief/config
  # rather than in every operator's shell. All are optional and all default to the
  # unattended-safe value; a project that sets none of them behaves exactly as before.
  export CHIEF_REVIEW CHIEF_REVIEWER CHIEF_REVIEW_TIMEOUT CHIEF_REVIEW_MAX_ROUNDS \
         CHIEF_REVIEW_NONINTERACTIVE
  # The per-story DIFF-SIZE BUDGET (engine/budget.sh · docs/reference/diff-budget.md).
  # Exported for the same reason: a repo's size policy belongs in .chief/config, not
  # in every operator's shell. All optional; unset means the documented defaults
  # (400 lines / 20 files per story, reported and NOT blocking).
  export CHIEF_DIFF_BUDGET CHIEF_DIFF_BUDGET_LINES CHIEF_DIFF_BUDGET_FILES
  export CHIEF_MACHINE_BUDGET
  # The OPT-IN BATCH MERGE QUEUE (engine/mergequeue.sh). Exported so a repo can set
  # its own policy in .chief/config rather than in every operator's shell. UNSET is
  # the default and the default is OFF: absent these, the merge phase is the
  # serialized rebase -> re-verify -> --no-ff floor, unchanged.
  export CHIEF_MERGE_BATCH CHIEF_MERGE_BATCH_WAIT
}

cmd_init() {
  local root="$PWD" f
  # Guard against the classic footgun: initializing in $HOME (or at the install
  # prefix). There, the project's `.chief/` dir IS `~/.chief` — the install prefix
  # that holds src/runs/repos — so project config collides with the engine, and
  # find_project would treat home as a project from almost anywhere.
  local prefix; prefix="$(chief_prefix)"
  if { [ -n "${HOME:-}" ] && [ "$root" = "$HOME" ]; } || [ "$root/.chief" = "$prefix" ] || [ "$root" = "$prefix" ]; then
    echo "ERROR: refusing to 'chief init' here — <repo>/.chief would collide with the Chief" >&2
    echo "       install prefix ($prefix). cd into a project repo (not your home dir) first." >&2
    exit 1
  fi
  # Chief operates on git branches/worktrees/merges — warn if this isn't a repo yet.
  # A bind-mounted repo owned by another uid ALSO fails `rev-parse`, and telling that
  # operator to `git init` an already-initialised repo sends them the wrong way.
  case "$(chief_git_probe "$root")" in
    ok) ;;
    ownership) echo "  note: git refuses this repo — dubious ownership (owned by another uid)." >&2
               echo "        Set CHIEF_GIT_SAFE_DIRECTORY=1 for 'chief run', or:" >&2
               echo "        git config --global --add safe.directory $root" >&2 ;;
    *) echo "  note: not a git repo yet — run 'git init' before 'chief run' (it needs a clean git tree on the base branch)." >&2 ;;
  esac
  mkdir -p "$root/.chief" "$root/tasks/chief/completed"
  # zones.conf ships with every line commented out — a scaffolded repo declares no
  # overlap zones and so behaves exactly as it did before the registry existed.
  for f in config verify.sh agent-context.md quality.conf zones.conf; do
    if [ -e "$root/.chief/$f" ]; then echo "  keep  .chief/$f (exists)"
    else cp "$TEMPLATES/$f" "$root/.chief/$f"; echo "  init  .chief/$f"; fi
  done
  chmod +x "$root/.chief/verify.sh" 2>/dev/null || true
  [ -e "$root/tasks/chief/example.json" ] || { cp "$TEMPLATES/tasklist.example.json" "$root/tasks/chief/example.json"; echo "  init  tasks/chief/example.json"; }
  grep -qxF '.chief/state/' "$root/.gitignore" 2>/dev/null || { echo '.chief/state/' >> "$root/.gitignore"; echo "  gitignore  .chief/state/"; }
  register_repo "$root"
  echo "✓ chief initialized. Edit .chief/{config,verify.sh,agent-context.md}, add tasklists, then: chief run"
}

# chief gen <roadmap.json> — roadmap document → tasklists (engine/gen.sh). The
# generator needs the project only for its tasks dir + numbering band, so --help
# answers without one.
cmd_gen() {
  case "${1:-}" in -h|--help|'') ;; *) load_project ;; esac
  bash "$ENGINE/gen.sh" "$@"
}

# chief lint [names…] — the AUTHORING-TIME half of the gates a run enforces, run
# against tasklists on disk. The tasklist gate (docs/reference/tasklist-schema.md)
# plus the criteria SCOPE rule the driver refuses to launch on (engine/criteria.sh):
# a criterion naming another repo cannot be satisfied from the worktree the story
# runs in, and catching that here costs a text edit instead of a run.
#
# It also resolves the MARKER LINK (engine/counterpart.sh): a tasklist may declare
# the downstream tasklist that will complete it, and a declaration pointing at a repo
# or stem that does not exist is worse than no declaration — it reads as checked.
# Resolution is the driver's own (engine/crossrepo.sh), so the two cannot disagree.
# The park cell `chief list` prints, computed by the jq that already reads the file: a
# park with no "parkedReason" renders exactly as it always has, "  (parked)", which is
# what keeps `chief list` a different tool with unchanged output.
#
# A TOP-LEVEL CONSTANT, not an inline multi-line '…' argument. engine/quality.sh's
# scanner blanks `$( … )` before it looks for the quote that opens an embedded program,
# so a `)` anywhere on the opening line eats the quote — and every line of the jq after
# it is then read as shell, whose `if` has no `fi`, which pins the nesting depth up and
# swallows every function boundary in the rest of the file. Opening the quote on a line
# of its own is exact (a single quote cannot nest or be escaped), and is the shape
# engine/status.sh's RECORD_JQ already uses.
LIST_PARK_JQ='
  if (.parked // false) then
    ((.parkedReason // "") | tostring | gsub("[\n\r\t]"; " ")) as $r
    | if $r == "" then "  (parked)" else "  (parked: " + $r + ")" end
  else "" end'

cmd_lint() {
  load_project
  . "$ENGINE/criteria.sh"
  . "$ENGINE/crossrepo.sh"
  . "$ENGINE/counterpart.sh"
  . "$ENGINE/terminal.sh"
  local d="$CHIEF_PROJECT/$CHIEF_TASKS_DIR" f n rep findings=0 checked=0 declared=0
  local files=()
  if [ "$#" -gt 0 ]; then
    for n in "$@"; do files+=("$d/${n%.json}.json"); done
  else
    for f in "$d"/*.json; do [ -e "$f" ] && files+=("$f"); done
  fi
  [ "${#files[@]}" -gt 0 ] || { echo "no tasklists in $d"; return 0; }
  for f in "${files[@]}"; do
    n="$(basename "$f" .json)"
    [ -f "$f" ] || { echo "  ✗ $n — no such tasklist: $f"; findings=$((findings + 1)); continue; }
    checked=$((checked + 1))
    if ! jq -e . "$f" >/dev/null 2>&1; then
      echo "  ✗ $n — not valid JSON"; findings=$((findings + 1)); continue
    fi
    jq -e --arg n "$n" '.branchName == "chief/\($n)"' "$f" >/dev/null 2>&1       || { echo "  ✗ $n — branchName is $(jq -r '.branchName // "(missing)"' "$f"), expected chief/$n"; findings=$((findings + 1)); }
    jq -e 'has("mergedToMain")|not' "$f" >/dev/null 2>&1       || { echo "  ✗ $n — carries mergedToMain; an unmerged tasklist must not claim to be merged"; findings=$((findings + 1)); }
    if jq -e '(.parked // false) and ((.parkedReason // "") | tostring | length == 0)' "$f" >/dev/null 2>&1; then
      echo "  ✗ $n — parked tasklist must carry parkedReason (use CLASS: explanation)"
      findings=$((findings + 1))
    fi
    # `terminalFalse` is a BOOLEAN (engine/terminal.sh). A truthy-looking string
    # ("true", "yes") is a declaration that silently does nothing, and the failure mode
    # of a silent declaration is exactly the one this field exists to fix: a story
    # everyone believes is settled, re-driven forever.
    rep="$(jq -r --arg k "$TERMINAL_FIELD" '
      .userStories[]? | select(has($k)) | select((.[$k] | type) != "boolean")
      | "      \(.id // "?") — \($k) is \(.[$k] | type), must be a boolean"' "$f" 2>/dev/null)"
    if [ -n "$rep" ]; then
      echo "  ✗ $n — a story's $TERMINAL_FIELD declaration is not a boolean:"
      printf '%s\n' "$rep"
      findings=$((findings + $(printf '%s\n' "$rep" | grep -c . || true)))
    fi
    rep="$(criteria_scope_report "$f" "$CHIEF_PROJECT")"
    if [ -n "$rep" ]; then
      echo "  ✗ $n — an acceptance criterion names work in another repo:"
      printf '%s
' "$rep"
      findings=$((findings + $(printf '%s
' "$rep" | grep -c '✗')))
    fi
    declared=$((declared + $(counterpart_refs "$f" | grep -c . || true)))
    rep="$(counterpart_lint_report "$f")"
    if [ -n "$rep" ]; then
      echo "  ✗ $n — its declared downstream counterpart does not resolve:"
      printf '%s
' "$rep"
      findings=$((findings + $(printf '%s
' "$rep" | grep -c '✗')))
    fi
  done
  # The marker link followed FORWARD (engine/counterpart.sh): a counterpart that has
  # MERGED while its marker is still live here. This is a REPORT, never a finding —
  # retiring a marker is a judgement call, and a lint that failed on somebody else's
  # merge would block authoring work that is otherwise fine. Rendered by the module,
  # so this and `chief list` cannot drift into two accounts of the same finding.
  counterpart_report_block "$CHIEF_TASKS_DIR" "${files[@]}"
  # What the gate SAW, always — the marker link is a field, and a counterpart named
  # only in a description is not detected here and is not claimed to be. "0 declared"
  # means nobody wrote the field, never that nobody has a counterpart.
  local seen="$declared \"$COUNTERPART_FIELD\" declaration(s) checked; a counterpart named only in prose is invisible to this gate"
  if [ "$findings" -gt 0 ]; then
    echo "✗ $findings finding(s) across $checked tasklist(s) ($seen). A cross-repo criterion is either rewritten as work in THIS repo, or declared: \"crossRepo\": [\"<repo>\"]." >&2
    return 1
  fi
  echo "✓ $checked tasklist(s) clean ($seen)"
}

# chief status — the BACKLOG question `chief list` does not answer: what is left,
# and what can start now. Deliberately does NOT call load_project: that hard-exits
# when there is no .chief/config, which is right for `run` and wrong for a report —
# and status is meant to run from ABOVE a set of repos as well as inside one, where
# there is no single project to load. The runnable/blocked verdict is the SCHEDULER'S
# — engine/status.sh runs the same engine/deps.sh the driver launches on, so the
# report cannot drift from the run. See docs/reference/status.md.
cmd_status() {
  bash "$ENGINE/status.sh" "$@"
}

# chief list — the backlog, and therefore the ONE place a finished marker has to be
# visible. The whole failure this repo's 102 tasklist describes is a marker sitting in
# `chief list` counting as pending months after the work shipped downstream; a check
# that only answered when someone thought to run it would have caught none of the five.
# So the marker link is followed here too (engine/counterpart.sh): the flagged rows are
# marked inline, and the block underneath names the counterpart, the merge sha and the
# order retirement has to happen in. It prints; it never changes the exit status.
cmd_list() {
  load_project
  . "$ENGINE/crossrepo.sh"
  . "$ENGINE/counterpart.sh"
  # SETTLED vs PASSING (engine/terminal.sh) — the PROGRESS column reports a story that
  # is done with the answer NO as "2+1/4", never folded into the passing count and
  # never left out of it.
  . "$ENGINE/terminal.sh"
  local all=0 plain=0 arg d f n c t g mark pk flagged="" completed=0 files=()
  while [ "$#" -gt 0 ]; do
    arg="$1"; shift
    case "$arg" in
      -a|--all) all=1 ;;
      --plain) plain=1 ;;
      -h|--help)
        cat <<'USAGE'
  chief list — list live tasklists with story progress.

  chief list              live and parked tasklists; completed ones are summarized
  chief list --all        include completed tasklists
  chief list --plain      stable tab-delimited rows for scripts (combine with --all)
USAGE
        return 0 ;;
      *) echo "chief list: unknown flag: $arg" >&2; return 2 ;;
    esac
  done
  local d="$CHIEF_PROJECT/$CHIEF_TASKS_DIR" f n c t mark pk flagged="" files=()
  local verdicts="" blocked="" category state reason
  for f in "$d"/*.json; do [ -e "$f" ] && files+=("$f"); done
  # Guarded on the COUNT, not entered blind: under `set -u` bash 3.2 treats
  # "${files[@]}" of an empty array as unbound, so a repo with no live tasklists
  # would die here rather than list its completed ones.
  if [ "${#files[@]}" -gt 0 ]; then
    # One scan for the whole listing — the markers whose counterpart has already
    # merged. LC_ALL=C: awk parses lines built from agent-authored tasklist names,
    # and BSD awk aborts on a multi-byte character in a UTF-8 locale.
    flagged="$(counterpart_scan "${files[@]}" | LC_ALL=C awk -F'\t' '$1=="done"{print $2}')"
    verdicts="$(bash "$ENGINE/status.sh" --json 2>/dev/null || echo '{}')"
    blocked="$(printf '%s' "$verdicts" | jq -r '.blocked[]? | [.tasklist, (.blocked_by // ""), (.detail // "")] | @tsv' 2>/dev/null || true)"
    if [ "$plain" -eq 0 ]; then
      printf '%-32s %-14s %-9s %-16s %s\n' NAME STATE PROGRESS CATEGORY REASON
      printf '%-32s %-14s %-9s %-16s %s\n' \
        '--------------------------------' '--------------' '---------' '----------------' '------'
    fi
    for f in "${files[@]}"; do
      n="$(basename "$f" .json)"
      terminal_counts "$f"
      t="$TERMINAL_TOTAL"; c="$TERMINAL_PASSED"; g="$TERMINAL_NEGATIVE"
      category="$(jq -r '.category // "(uncategorized)"' "$f" 2>/dev/null || echo '(uncategorized)')"
      state="ready"; { [ "$c" != 0 ] || [ "$g" != 0 ]; } && [ "$c" != '?' ] && state="in-progress"
      [ "$g" != 0 ] && c="$c+$g"
      reason=""
      pk="$(jq -r "$LIST_PARK_JQ" "$f" 2>/dev/null)"
      if [ -n "$pk" ]; then
        state="parked"
        reason="$(jq -r '.parkedReason // "(no reason given)"' "$f" 2>/dev/null || echo '(no reason given)')"
      else
        while IFS=$'\t' read -r bn bd br; do
          [ "$bn" = "$n" ] || continue
          state="blocked"; reason="needs ${bd:-dependency}"
          [ -n "$br" ] && reason="$reason — $br"
        done <<EOF
$blocked
EOF
      fi
      if [ "$plain" -eq 1 ]; then
        printf '%s\t%s\t%s/%s\t%s\t%s\n' "$n" "$state" "$c" "$t" "$category" "$reason"
        continue
      fi
      # -x, not a substring test: "57-foo" must not flag "157-foo".
      mark=""; printf '%s\n' "$flagged" | grep -qxF -- "$n" && mark='  ⚑ counterpart merged'
      [ -n "$mark" ] && reason="${reason:+$reason; }counterpart merged"
      printf '%-32s %-14s %-9s %-16s %s\n' "$n" "$state" "$c/$t" "$category" "$reason"
    done
  fi
  for f in "$d"/completed/*.json; do
    [ -e "$f" ] || continue
    completed=$((completed + 1))
    if [ "$all" -eq 1 ]; then
      n="$(basename "$f" .json)"
      if [ "$plain" -eq 1 ]; then
        printf '%s\tdone\t-\t%s\t\n' "$n" "$(jq -r '.category // "(uncategorized)"' "$f" 2>/dev/null || echo '(uncategorized)')"
      else
        printf '%-32s %-14s %-9s %-16s %s\n' "$n" done - "$(jq -r '.category // "(uncategorized)"' "$f" 2>/dev/null || echo '(uncategorized)')" ""
      fi
    fi
  done
  if [ "$all" -eq 0 ]; then
    if [ "$plain" -eq 1 ]; then
      printf '# %d completed tasklist(s) omitted; use --all to show\n' "$completed"
    else
      printf '\n(%d completed tasklist(s) omitted; use --all to show)\n' "$completed"
    fi
  fi
  [ "${#files[@]}" -gt 0 ] && counterpart_report_block "$CHIEF_TASKS_DIR" "${files[@]}"
  return 0
}

cmd_run() {
  # Every toggle here starts EMPTY, never at its default value: these are FLAGS, and
  # the rule for the whole block is "a flag overrides the environment, an unset flag
  # does not clobber it". Seeding `dry=0`/`parallel=1` and then splicing them into the
  # driver's assignment prefix is what made `DRY_RUN=1 chief run` perform a REAL run.
  local parallel="" dry="" merge="" provider="" model="" preset="" verbose="" headless="" \
        account_env="" account_label="" merge_batch="" ; local names=()
  while [ "$#" -gt 0 ]; do case "$1" in
    -p|--parallel) parallel="$2"; shift 2 ;;
    -p*)           parallel="${1#-p}"; shift ;;
    -n|--dry-run)  dry=1; shift ;;
    -V|--verbose)  verbose=1; shift ;;
    --headless)    headless=1; shift ;;
    --no-merge)    merge=0; shift ;;
    # The merge queue is OPT-IN and it is opted into HERE, per run. Bare = 4, a
    # deliberately small default: a batch is a bet that N branches are jointly green,
    # and the bet gets worse as N grows. `--merge-batch=1` is the floor (i.e. off).
    --merge-batch)   merge_batch=4; shift ;;
    --merge-batch=*) merge_batch="${1#*=}"; shift ;;
    --provider)    provider="$2"; shift 2 ;;
    --provider=*)  provider="${1#*=}"; shift ;;
    --model)       model="$2"; shift 2 ;;
    --model=*)     model="${1#*=}"; shift ;;
    --preset)      preset="$2"; shift 2 ;;
    --preset=*)    preset="${1#*=}"; shift ;;
    --local)       preset=local; shift ;;   # shorthand for --preset local
    # Run a NAMED park anyway; without it the driver prints its reason and stops.
    --parked)      export CHIEF_RUN_PARKED=1; shift ;;
    --claude)      provider=claude; shift ;;
    --devin)       provider=devin; shift ;;
    --opencode)    provider=opencode; shift ;;
    --amp)         provider=amp; shift ;;
    --codex)       provider=codex; shift ;;
    --account-env)   account_env="$2"; shift 2 ;;
    --account-env=*) account_env="${1#*=}"; shift ;;
    --account-label)   account_label="$2"; shift 2 ;;
    --account-label=*) account_label="${1#*=}"; shift ;;
    --tool)        provider="$2"; shift 2 ;; # compatibility with pre-provider releases
    --tool=*)      provider="${1#*=}"; shift ;;
    -*)            echo "unknown flag: $1" >&2; exit 2 ;;
    *)             names+=("$1"); shift ;;
  esac; done
  load_project
  # PRESET first (engine/preset.sh): a named bundle that RESOLVES to a provider·model
  # (+ whatever backend env it needs) before the ordinary provider/model defaulting, so
  # the rest of the run — driver, ps/monitor, events — sees only the resolved pair.
  # It is handed the EXPLICIT flags, not the config defaults, so a conflicting
  # --provider is an error rather than something the preset silently overrides.
  preset="${preset:-${CHIEF_PRESET:-}}"
  if [ -n "$preset" ]; then
    # shellcheck disable=SC1091
    source "$ENGINE/preset.sh"
    CHIEF_PRESET="$preset" CHIEF_PROVIDER="$provider" CHIEF_MODEL="$model"
    chief_preset_resolve || exit 2
    provider="$CHIEF_PROVIDER"; model="$CHIEF_MODEL"
    export CHIEF_PRESET="$preset"
  fi
  local model_explicit="$model"        # flag/preset value, before the config default
  # PROVIDER/MODEL already obey the rule AT THIS SITE — the flag wins, and with no flag
  # the value load_project() resolved is passed through untouched. They differ from
  # PARALLEL/DRY_RUN on the OTHER axis, deliberately: load_project() sources
  # .chief/config over the ambient environment, so exporting CHIEF_PROVIDER into a
  # run does not select a provider (docs/guides/headless-invocation.md says so).
  # It must stay that way, because chief EXPORTS these two to every child it spawns:
  # an ambient CHIEF_PROVIDER is as likely to be an outer run's bookkeeping as an
  # operator's request, and a `chief run` nested inside an agent turn must obey the
  # inner project's config rather than inherit the outer run's provider. --provider /
  # --model are the per-invocation override; .chief/config is the project setting.
  provider="${provider:-$CHIEF_PROVIDER}"; model="${model:-$CHIEF_MODEL}"
  case "$provider" in
    claude|devin|opencode|amp|codex) ;;
    *) echo "invalid provider '$provider' (choose claude, devin, opencode, amp, or codex)" >&2; exit 2 ;;
  esac
  # amp has no model selector — it picks its own (docs/guides/providers.md#model-overrides).
  # Accept-and-ignore is barred, so an EXPLICIT --model is a bad invocation. A model
  # merely inherited from .chief/config is dropped with a note instead, so `chief run
  # --amp` still works in a project whose default provider takes a model.
  if [ "$provider" = amp ] && [ -n "$model" ]; then
    if [ -n "$model_explicit" ]; then
      echo "amp has no model selector — drop --model '$model_explicit' (docs/guides/providers.md#model-overrides)" >&2
      exit 2
    fi
    echo "  note: amp has no model selector — dropping CHIEF_MODEL='$model' for this run" >&2
    model=""
  fi
  # Export the optional toggles instead of splicing "VAR=val" via ${x:+…} into the
  # command's assignment-prefix position — an EXPANSION there isn't recognized as an
  # assignment, so bash tries to RUN it ("AUTO_MERGE_MAIN=0: command not found").
  [ -n "$verbose" ] && export CHIEF_VERBOSE=1    # inherited by the driver, forwarded to agent.sh
  [ -n "$merge" ]   && export AUTO_MERGE_MAIN="$merge"
  # A bad --merge-batch is a bad invocation, not something to silently round down to
  # the floor: an operator who asked for batching and got the serialized path would
  # read the (identical) log as proof that batching does nothing.
  if [ -n "$merge_batch" ]; then
    case "$merge_batch" in
      ''|*[!0-9]*|0) echo "--merge-batch: expected a positive integer, got '$merge_batch'" >&2; exit 2 ;;
    esac
    export CHIEF_MERGE_BATCH="$merge_batch"
  fi
  # HEADLESS — the programmatic entry point (docs/guides/headless-invocation.md). Explicit,
  # never inferred from `[ -t 1 ]`: a host that pipes an interactive run through `tee`
  # must get the SAME behavior it gets on a terminal, and a contract that changes
  # shape depending on how stdout happens to be attached is not one you can code
  # against. `--headless` (or CHIEF_HEADLESS=1 in the environment / .chief/config) is
  # the one switch, and it only ever ADDS machine-readable output.
  [ -n "$headless" ] && CHIEF_HEADLESS=1
  case "${CHIEF_HEADLESS:-0}" in
    1|true|yes|on)
      export CHIEF_HEADLESS=1
      # Children (the provider CLI, git, any warmup command) inherit the standard
      # "don't emit ANSI" signals, so a captured stream stays line-oriented plain
      # text even when a tool would otherwise colorize for its own reasons.
      export NO_COLOR=1 CLICOLOR=0 GIT_PAGER=cat
      ;;
    *) export CHIEF_HEADLESS=0 ;;
  esac
  # ACCOUNT DESIGNATION (docs/reference/account-credentials.md) — pin this run's provider turns
  # to a designated account by naming a KEY=VALUE credential env FILE. A file, not
  # flags: secret VALUES must never reach argv, where `ps` shows them to every user on
  # the box. The flag beats .chief/config's CHIEF_ACCOUNT_ENV_FILE, and the path is
  # resolved HERE, against the invoking cwd — the driver and every worker run from a
  # worktree, so a relative path handed onward would resolve somewhere else entirely.
  # Unreadable = a launch error, never a silent fall-back to the inherited account.
  account_env="${account_env:-${CHIEF_ACCOUNT_ENV_FILE:-}}"
  if [ -n "$account_env" ]; then
    case "$account_env" in /*) ;; *) account_env="$PWD/$account_env" ;; esac
    if [ ! -f "$account_env" ] || [ ! -r "$account_env" ]; then
      echo "--account-env: no readable credential env file at $account_env" >&2
      exit 2
    fi
    export CHIEF_ACCOUNT_ENV_FILE="$account_env"
  else
    unset CHIEF_ACCOUNT_ENV_FILE
  fi
  # THE LABEL IS THE PUBLIC HALF OF THE DESIGNATION. Everything the run publishes
  # about its account — the registry entry `chief ps`/`chief monitor` read, the
  # run.started event a headless host subscribes to, the verbose trace — names the
  # account by this label and by the env-file PATH, never by a value out of the file.
  # That is what lets an operator (or chief-cloud's pooler) see WHICH account a run is
  # spending without any surface carrying the credential itself.
  # Defaulted from the file's basename (minus a .env suffix) so a designated run is
  # always identifiable even when nobody passed --account-label. Scrubbed here, once:
  # it is operator-supplied text that ends up in a key=value registry line and in JSON.
  account_label="${account_label:-${CHIEF_ACCOUNT_LABEL:-}}"
  if [ -z "$account_label" ] && [ -n "$account_env" ]; then
    account_label="$(basename "$account_env")"; account_label="${account_label%.env}"
  fi
  if [ -n "$account_label" ]; then
    account_label="$(printf '%s' "$account_label" | tr -d '"\\$`' | tr '\n\r\t' '   ' | cut -c1-60)"
    export CHIEF_ACCOUNT_LABEL="$account_label"
  else
    unset CHIEF_ACCOUNT_LABEL
  fi
  # PARALLEL and DRY_RUN are forwarded ONLY when a flag set them. The driver already
  # defaults both (PARALLEL="${PARALLEL:-1}", DRY_RUN="${DRY_RUN:-0}"), so passing a
  # seeded default here would override the operator's environment with it — which is
  # how `DRY_RUN=1 chief run` came to launch a real run that was only noticed by the
  # appearance of a worktree. Exported, not spliced into the assignment prefix, for the
  # reason recorded above CHIEF_VERBOSE. Provider/model are unconditional because they
  # are already resolved through the environment above.
  [ -n "$dry" ]      && export DRY_RUN=1
  [ -n "$parallel" ] && export PARALLEL="$parallel"
  CHIEF_PROVIDER="$provider" CHIEF_MODEL="$model" \
    bash "$ENGINE/driver.sh" ${names[@]+"${names[@]}"}
}

cmd_ps() {
  local all=0 arg
  while [ "$#" -gt 0 ]; do
    arg="$1"; shift
    case "$arg" in -a|--all) all=1 ;; *) echo "chief ps: unknown flag: $arg" >&2; return 2 ;; esac
  done
  if [ "$all" -eq 1 ]; then load_project; export CHIEF_PS_REPO="$CHIEF_PROJECT"; fi
  bash "$ENGINE/monitor.sh" "$([ "$all" -eq 1 ] && echo once-all || echo once)"
}
# EXEC, not fork: `chief monitor` is a view, and a view is one process. Forking left
# this wrapper blocked in wait() for the whole session — a second process per watcher,
# and the one whose death re-parented the watcher to init instead of ending it (see
# monitor.sh's THE WATCH LOOP'S STOP CONDITION). `chief ps` returns, so it stays a
# plain call.
cmd_monitor() {
  local all=0 interval=2 arg
  while [ "$#" -gt 0 ]; do
    arg="$1"; shift
    case "$arg" in
      -a|--all) all=1 ;;
      ''|*[!0-9]*) echo "chief monitor: expected an interval or --all: $arg" >&2; return 2 ;;
      *) interval="$arg" ;;
    esac
  done
  if [ "$all" -eq 1 ]; then load_project; export CHIEF_PS_REPO="$CHIEF_PROJECT"; fi
  exec bash "$ENGINE/monitor.sh" "$([ "$all" -eq 1 ] && echo watch-all || echo watch)" "$interval"
}

# chief logs [name] [-f] [-n N] — hook into a live run's output. Each tasklist's
# per-iteration output is teed to <state>/parallel/<name>.log; this tails it so you
# can watch what an agent is actually doing (the provider's stdout, gate output,
# stall notes) without stopping the run.
cmd_logs() {
  local follow="" name="" lines=200 rf p g
  while [ $# -gt 0 ]; do
    case "$1" in
      -f|--follow)  follow=1 ;;
      -n|--lines)   shift; lines="${1:-200}" ;;
      -*)           echo "chief logs: unknown flag: $1" >&2; return 2 ;;
      *)            name="$1" ;;
    esac; shift
  done

  # Resolve the run's state dir: the repo under $PWD if it has run state, else the
  # sole live run in the registry (ambiguous → list and ask the operator to choose).
  local state="" proj live=() sd="${CHIEF_STATE_DIR:-.chief/state}"
  if proj="$(find_project 2>/dev/null)" && [ -d "$proj/$sd/parallel" ]; then
    state="$proj/$sd"
  else
    for rf in "$CHIEF_RUNS"/*.run; do
      [ -e "$rf" ] || continue
      p="$(run_field pid "$rf")"
      [ -n "$p" ] && kill -0 "$p" 2>/dev/null && live+=("$rf")
    done
    case "${#live[@]}" in
      1) state="$(run_field state "${live[0]}")" ;;
      0) echo "chief logs: no active run (cd into a repo with a run, or start one)"; return 1 ;;
      *) echo "chief logs: multiple active runs — cd into the one you want:"
         for rf in "${live[@]}"; do printf '  %s\n' "$(basename "$(run_field repo "$rf")")"; done
         return 1 ;;
    esac
  fi
  local pdir="$state/parallel"
  [ -d "$pdir" ] || { echo "chief logs: no run state under $pdir"; return 1; }

  # Default to the running tasklist when unambiguous; otherwise list what's available.
  if [ -z "$name" ]; then
    local running=()
    for g in "$pdir"/*.state; do
      [ -e "$g" ] || continue
      [ "$(cat "$g" 2>/dev/null)" = running ] && running+=("$(basename "${g%.state}")")
    done
    if [ "${#running[@]}" -eq 1 ]; then name="${running[0]}"
    else
      echo "tasklist logs under $pdir:"
      for g in "$pdir"/*.log; do [ -e "$g" ] && printf '  %s\n' "$(basename "${g%.log}")"; done
      echo "pick one:  chief logs <name> [-f]"
      return 0
    fi
  fi

  local log="$pdir/$name.log"
  [ -f "$log" ] || { echo "chief logs: no log for '$name' (looked in $log)"; return 1; }
  if [ -n "$follow" ]; then
    printf '── following %s · %s (Ctrl-C to stop) ──\n' "$name" "$log"
    exec tail -n "$lines" -f "$log"
  else
    tail -n "$lines" "$log"
  fi
}

# ── the machine-readable EVENT STREAM (docs/reference/events.md) ───────────────────────
# `chief logs` hands you an agent's raw stdout for a HUMAN to read; this is its
# machine-facing sibling. engine/events.sh appends one JSON object per
# run/tasklist/story transition to $CHIEF_RUNS/<run-id>.events.jsonl, and this
# command is the subscribe surface over it — what chief-cloud's daemon and an
# embedding host follow INSTEAD of polling <name>.live.json and diffing it
# themselves (which loses every transition between two polls).
#
# STDOUT IS PURE NDJSON. Every banner, warning and hint goes to stderr, so
#   chief events -f | jq -c 'select(.event=="tasklist.merged")'
# works with nothing in the way. Reading is entirely passive: this never writes to
# the registry, never signals anything, and never touches a run.
events_file_of() { printf '%s/%s.events.jsonl' "$CHIEF_RUNS" "$1"; }   # $1 = run-id
events_id_of()   { local b; b="$(basename "$1")"; printf '%s' "${b%.events.jsonl}"; }

# The run-ids with a LIVE driver behind them, one per line (same liveness test as
# `chief ps`: the run file's pid still answers).
events_live_ids() {
  local rf p id
  for rf in "$CHIEF_RUNS"/*.run; do
    [ -e "$rf" ] || continue
    p="$(run_field pid "$rf")"; id="$(run_field runid "$rf")"
    [ -n "$p" ] && [ -n "$id" ] && kill -0 "$p" 2>/dev/null && printf '%s\n' "$id"
  done
}

# Newest log in the registry, by mtime. These logs deliberately OUTLIVE their run
# (bounded only by CHIEF_EVENTS_KEEP_DAYS, default 14), which is what makes
# `chief events` useful after the fact and not only while something is running.
events_newest() {
  local f newest=""
  for f in "$CHIEF_RUNS"/*.events.jsonl; do
    [ -e "$f" ] || continue
    if [ -z "$newest" ] || [ "$f" -nt "$newest" ]; then newest="$f"; fi
  done
  [ -n "$newest" ] && printf '%s' "$newest"
}

cmd_events() {
  local follow="" want="" lines="" list="" f id file="" any=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -f|--follow) follow=1 ;;
      -n|--lines)  shift; lines="${1:-}" ;;
      -l|--list)   list=1 ;;
      -*)          echo "chief events: unknown flag: $1" >&2; return 2 ;;
      *)           want="$1" ;;
    esac; shift
  done
  if [ -n "$lines" ]; then
    case "$lines" in ''|*[!0-9]*) echo "chief events: -n wants a number of lines" >&2; return 2 ;; esac
  fi

  # -l/--list: what a host can subscribe to on this machine.
  if [ -n "$list" ]; then
    local live_ids; live_ids=" $(events_live_ids | tr '\n' ' ') "
    for f in "$CHIEF_RUNS"/*.events.jsonl; do
      [ -e "$f" ] || continue
      any=1; id="$(events_id_of "$f")"
      case "$live_ids" in
        *" $id "*) printf '%s\tlive\t%s events\t%s\n'  "$id" "$(wc -l < "$f" | tr -d ' ')" "$f" ;;
        *)         printf '%s\tended\t%s events\t%s\n' "$id" "$(wc -l < "$f" | tr -d ' ')" "$f" ;;
      esac
    done
    [ -n "$any" ] || echo "chief events: no event logs in $CHIEF_RUNS" >&2
    return 0
  fi

  # Which log? An explicit run-id (or path) wins; otherwise the sole live run;
  # otherwise the most recent log, which is what you want right after a run ended.
  if [ -n "$want" ]; then
    case "$want" in
      */*) file="$want" ;;
      *)   file="$(events_file_of "$want")" ;;
    esac
  else
    local n=0 first=""
    while IFS= read -r id; do
      [ -n "$id" ] || continue
      n=$(( n + 1 )); [ -z "$first" ] && first="$id"
    done <<EOF
$(events_live_ids)
EOF
    case "$n" in
      1) file="$(events_file_of "$first")" ;;
      0) file="$(events_newest)"
         [ -n "$file" ] || { echo "chief events: no active run and no event log in $CHIEF_RUNS" >&2; return 1; }
         echo "chief events: no active run — reading the most recent log ($(events_id_of "$file"))" >&2 ;;
      *) echo "chief events: multiple active runs — name the one you want:" >&2
         events_live_ids | sed 's/^/  /' >&2
         echo "  chief events <run-id> [-f]" >&2
         return 1 ;;
    esac
  fi

  # A host that launches a run and subscribes immediately can beat the driver to the
  # first event. Wait briefly for the log rather than making the host poll for it.
  if [ ! -f "$file" ] && [ -n "$follow" ]; then
    local w=0
    while [ ! -f "$file" ] && [ "$w" -lt 15 ]; do sleep 1; w=$(( w + 1 )); done
  fi
  [ -f "$file" ] || { echo "chief events: no event log at $file" >&2; return 1; }

  if [ -n "$follow" ]; then
    printf '── events · %s · %s (Ctrl-C to stop) ──\n' "$(events_id_of "$file")" "$file" >&2
    exec tail -n "${lines:-+1}" -f "$file"
  elif [ -n "$lines" ]; then
    tail -n "$lines" "$file"
  else
    cat "$file"
  fi
}

# `chief usage` is deliberately a projection over the append-only event logs. It must not
# become a second ledger: there is no state file, provider call, or registry mutation here.
# Usage is nullable in the event schema, so blank measurements remain distinct from zero.
cmd_usage() {
  local files=() f rows totals row id turns in out total cost hits wait reset
  local days="" repo="" json=0 cutoff now
  while [ $# -gt 0 ]; do
    case "$1" in
      --days|-d) shift; days="${1:-}" ;;
      --repo|--scope) shift; repo="${1:-}" ;;
      --json) json=1 ;;
      -h|--help) printf '%s\n' 'Usage: chief usage [--days N] [--repo PATH|--scope PATH] [--json]'; return 0 ;;
      -*) echo "chief usage: unknown flag: $1" >&2; return 2 ;;
      *) echo "chief usage: unexpected argument: $1" >&2; return 2 ;;
    esac
    shift
  done
  if [ -n "$days" ]; then
    case "$days" in ''|*[!0-9]*|0) echo 'chief usage: --days wants a positive integer' >&2; return 2 ;; esac
  fi
  if [ -n "$repo" ]; then
    [ -d "$repo" ] || { echo "chief usage: repo is not a directory: $repo" >&2; return 2; }
    repo="$(cd -P "$repo" && pwd)"
  fi
  now="$(date +%s)"; cutoff=0
  [ -n "$days" ] && cutoff=$((now - days * 86400))
  for f in "$CHIEF_RUNS"/*.events.jsonl; do
    [ -f "$f" ] && files+=("$f")
  done
  if [ "${#files[@]}" -eq 0 ]; then
    if [ "$json" -eq 1 ]; then
      jq -n --arg repo "$repo" --argjson days "${days:-null}" \
        '{chief:"usage",scope:{repo:(if $repo=="" then null else $repo end),days:$days},runs:[],total:{turns:0,input_tokens:null,output_tokens:null,total_tokens:null,cost_usd:null,limit_incidents:0,wait_seconds:0,last_reset_eta:null}}'
    else echo "chief usage: no event logs in $CHIEF_RUNS"; fi
    return 0
  fi

  rows="$(jq -r -s --arg repo "$repo" --argjson cutoff "$cutoff" '
    def present_sum($key):
      [ .[] | .usage?[$key]? | select(type == "number") ] as $v
      | if ($v|length) == 0 then "" else (($v|add)|tostring) end;
    [ .[] | select((.ts // 0) >= $cutoff)
      | select($repo == "" or (.repo? == $repo) or ((.repo? // "") | startswith($repo + "/"))) ] as $events
    | $events
    | group_by(.runId) | .[]
    | [ .[] | select(.event == "agent.turn") ] as $turns
    | [ .[] | select(.limit?.hit == true) ] as $limits
    | ($limits | sort_by(.ts) | map(.limit.retry_at? | select(type == "number"))
       | if length == 0 then "" else (.[-1]|tostring) end) as $reset
    | ([ $limits[] | select((.limit.retry_at? | type) == "number")
          | ((.limit.retry_at - .ts) | select(. > 0)) ] | add // 0) as $wait
    | [((.[0].runId) // "unknown"), ($turns|length|tostring),
       (present_sum("input_tokens")), (present_sum("output_tokens")),
       (present_sum("total_tokens")), (present_sum("cost_usd")),
       ($limits|length|tostring), ($wait|tostring), $reset] | @tsv
  ' "${files[@]}")" || {
    echo "chief usage: could not read event logs in $CHIEF_RUNS" >&2
    return 1
  }

  if [ "$json" -eq 1 ]; then
    jq -n --arg repo "$repo" --argjson days "${days:-null}" --arg rows "$rows" '
      def nums($i): [$rows|split("\n")[]|select(length>0)|split("\t")[$i]|select(length>0)|tonumber];
      def sum($i): (nums($i)|if length==0 then null else add end);
      ($rows|split("\n")|map(select(length>0)|split("\t"))) as $r |
      {chief:"usage",scope:{repo:(if $repo=="" then null else $repo end),days:$days},
       runs:($r|map({run_id:.[0],turns:(.[1]|tonumber),usage:{input_tokens:(if .[2]=="" then null else (.[2]|tonumber) end),output_tokens:(if .[3]=="" then null else (.[3]|tonumber) end),total_tokens:(if .[4]=="" then null else (.[4]|tonumber) end),cost_usd:(if .[5]=="" then null else (.[5]|tonumber) end)},limits:{incidents:(.[6]|tonumber),wait_seconds:(.[7]|tonumber),last_reset_eta:(if .[8]=="" then null else (.[8]|tonumber) end)}})),
       total:{turns:([$r[]|.[1]|tonumber]|add//0),input_tokens:sum(2),output_tokens:sum(3),total_tokens:sum(4),cost_usd:sum(5),limit_incidents:([$r[]|.[6]|tonumber]|add//0),wait_seconds:([$r[]|.[7]|tonumber]|add//0),last_reset_eta:([ $r[]|.[8]|select(length>0)|tonumber]|if length==0 then null else max end)}}
    '
    return 0
  fi

  printf 'Usage report · %s\n' "$CHIEF_RUNS"
  printf '%-32s %6s %14s %15s %14s %10s %6s %10s %16s\n' \
    'Run' 'Turns' 'Input tokens' 'Output tokens' 'Total tokens' 'Cost (USD)' 'Limits' 'Wait (s)' 'Last reset ETA'
  printf '%s\n' "$rows" | while IFS="$(printf '\t')" read -r id turns in out total cost hits wait reset; do
    printf '%-32s %6s %14s %15s %14s %10s %6s %10s %16s\n' \
      "$id" "$turns" "$in" "$out" "$total" "$cost" "$hits" "$wait" "$reset"
  done

  totals="$(printf '%s\n' "$rows" | jq -r -R -s '
    split("\n") | map(select(length > 0) | split("\t")) as $r
    | ["TOTAL", ($r|map(.[1]|tonumber)|add|tostring),
       (if ([$r[]|.[2]|select(length > 0)]|length)==0 then "" else ([$r[]|.[2]|tonumber]|add|tostring) end),
       (if ([$r[]|.[3]|select(length > 0)]|length)==0 then "" else ([$r[]|.[3]|tonumber]|add|tostring) end),
       (if ([$r[]|.[4]|select(length > 0)]|length)==0 then "" else ([$r[]|.[4]|tonumber]|add|tostring) end),
       (if ([$r[]|.[5]|select(length > 0)]|length)==0 then "" else ([$r[]|.[5]|tonumber]|add|tostring) end),
       ($r|map(.[6]|tonumber)|add|tostring), ($r|map(.[7]|tonumber)|add|tostring),
       ([$r[]|.[8]|select(length > 0)]|if length == 0 then "" else .[-1] end)] | @tsv
  ' )"
  printf '%s\n' "$totals" | while IFS="$(printf '\t')" read -r id turns in out total cost hits wait reset; do
    printf '%-32s %6s %14s %15s %14s %10s %6s %10s %16s\n' \
      "$id" "$turns" "$in" "$out" "$total" "$cost" "$hits" "$wait" "$reset"
  done
}

# chief models [provider] — what to pass to --model. Delegates to each provider's own
# enumeration where it has one (devin, opencode — the lists are account-specific and
# change often, so never hardcode them); claude has no listing command, so print its
# stable family aliases. Outside/custom models: use the opencode provider.
_models_claude() {
  cat <<'EOF'
claude — model aliases (each resolves to the newest version of its family):
  opus · sonnet · haiku · fable    (also: default, opusplan, or a full model id e.g. claude-opus-5)
  claude has no model-listing command; for outside/custom models, use the opencode provider.
EOF
}
cmd_models() {
  case "${1:-}" in
    claude)   _models_claude ;;
    devin)    if command -v devin    >/dev/null 2>&1; then devin models list;            else echo "devin CLI not on PATH";    return 1; fi ;;
    opencode) if command -v opencode >/dev/null 2>&1; then opencode models ${2:+"$2"};   else echo "opencode CLI not on PATH"; return 1; fi ;;
    amp)      echo "amp — no model selector: the CLI chooses its own model, so there is nothing to pass to --model."
              echo "      chief refuses an explicit '--model' for amp rather than ignoring it (docs/guides/providers.md#model-overrides)." ;;
    codex)    echo "codex — takes --model (wired to 'codex exec --model'), but the CLI has NO listing command:"
              echo "      'codex --help' exposes no 'models' subcommand, so there is nothing to enumerate."
              echo "      Pass a model id straight through, e.g. chief run --codex --model gpt-5.6-terra." ;;
    ""|all|help)
      _models_claude
      echo
      echo "devin    — live, per-account list:  chief models devin        (= devin models list)"
      echo "opencode — live list:               chief models opencode     (= opencode models [provider])"
      echo "amp      — none: amp has no model selector; --model is refused for it"
      echo "codex    — no listing command; --model is wired and passed through as given"
      ;;
    *) echo "chief models: unknown provider '$1' (claude | devin | opencode | amp | codex)" >&2; return 2 ;;
  esac
}
# Host-wide orphan sweep. Deliberately NOT gated on load_project: the whole point is
# that an orphan can be stopped without starting a new run on the repo that stranded
# it (the old sweep only ever ran at driver startup, so an orphan spent unwatched
# until someone happened to re-run that repo).
cmd_reap()    { bash "$ENGINE/reap.sh" "$@" ; }

# ── the code-quality ratchet (the SECOND, measured axis of the merge gate) ───
# The verify hook is a pass/fail test oracle: it answers "did the gates exit 0",
# which is blind to maintainability damage (duplication, ballooning functions,
# deep nesting) because tests come back in seconds and that damage shows up in
# weeks. `chief quality` measures it deterministically — awk over text, no model
# judgment anywhere — and its `ratchet` subcommand is what a verify hook calls to
# BLOCK a merge that made the numbers worse. Not gated on load_project: measuring
# a repo is useful with or without a chief run behind it. Contract + defaults:
# docs/reference/verify-hook.md.
cmd_quality() { bash "$ENGINE/quality.sh" "$@" ; }

# ── the DECLARED CI gate: did it actually run? (engine/cigate.sh) ────────────
# A REPORT, never a block. Measured 2026-08-25, every private repo in this
# portfolio had dead CI for an unknown period and nothing anywhere said so: GitHub
# Actions is free for public repositories and billed for private ones, so one
# account-level billing block killed the gate on every private repo while the
# public ones kept working and kept looking normal. A gate that never EXECUTES is
# otherwise indistinguishable, from every surface chief offers, from one that ran
# and passed.
#
# Not gated on load_project: the question is about a REPO, not about a chief
# project, and `--all` deliberately answers it for every repo in the registry at
# once — which is the scope the failure had. Never on the merge path, and it exits
# 0 on a finding, because chief refusing to merge over a third-party billing
# problem would be a worse failure than the one it is reporting.
cmd_cigate() {
  # shellcheck source=engine/cigate.sh
  . "$ENGINE/cigate.sh"
  local verbose=0 sha="" head=0 roots=() r rows all_rows="" total=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -a|--all)     while IFS= read -r r; do [ -d "$r" ] && roots+=("$r"); done < <(cat "$CHIEF_REPOS" 2>/dev/null) ;;
      -v|--verbose) verbose=1 ;;
      --head)       head=1 ;;
      --sha)        sha="${2:-}"; shift ;;
      -*)           echo "chief cigate: unknown option $1" >&2; return 2 ;;
      *)            roots+=("$1") ;;
    esac
    shift
  done
  if [ "${#roots[@]}" -eq 0 ]; then
    r="$(git rev-parse --show-toplevel 2>/dev/null)" || r="$(find_project 2>/dev/null)"
    [ -n "$r" ] || { echo "chief cigate: not inside a repo — pass a path, or -a for every known repo" >&2; return 2; }
    roots=("$r")
  fi
  for r in "${roots[@]}"; do
    [ -d "$r" ] || { echo "  ? $(basename "$r") — no such directory: $r"; continue; }
    [ "$head" = 1 ] && sha="$(git -C "$r" rev-parse HEAD 2>/dev/null || true)"
    rows="$(cigate_scan "$r" "$sha")"
    [ -n "$rows" ] || continue
    all_rows="${all_rows}${rows}
"
    total=$((total + 1))
  done
  cigate_summary "$all_rows" "$total" "$verbose"
}

# ── retiring a tasklist whose answer was NO (engine/retire.sh) ───────────────
# The one retirement an operator makes by hand. Chief retires a FINISHED tasklist by
# merging it; a tasklist whose remaining story TERMINATED FALSE (engine/terminal.sh)
# has finished too — it delivered a finding rather than a passing story — and before
# this there was no command for that, so `283`'s agent asking in its notes for MANUAL
# RETIREMENT had nowhere for the ask to land. Gated on load_project because it files
# into the project's tasks dir and reads the project's state, both of which the
# project's own .chief/config may have relocated.
cmd_retire()  { load_project; bash "$ENGINE/retire.sh" "$@" ; }

# ── overlap-zone approval (the YES no automated gate can give) ───────────────
# The merge floor — rebase, re-verify, merge --no-ff — is chief's correctness
# guarantee, and it is blind to exactly one thing: two parallel branches whose code
# does not collide and whose DESIGNS disagree. Both rebase clean, both verify green.
# A repo names the domains where that is unacceptable in .chief/zones.conf with
# policy `review` (engine/zones.sh · docs/reference/overlap-zones.md); a branch that
# changed one is held AFTER the floor ran, in state 'awaiting-approval', and this is
# the command that releases it.
#
# The verdict is a FILE next to the driver's state, so it survives process death, a
# rebuilt worktree and the end of the run — and it is BOUND by checksum to the change
# it approved (the branch's changed-file list plus the zones matched), so a yes never
# silently carries over to the next thing that branch does.
#
# No name (or --list) reports what is waiting. Idempotent: approving twice is a no-op
# that exits 0, exactly like `chief pause` on an already-paused repo.
cmd_approve() {
  local list=0 note="" names="" n rc=0 state found=0
  while [ "$#" -gt 0 ]; do case "$1" in
    -l|--list)  list=1; shift ;;
    -m|--note)  [ "$#" -ge 2 ] || { echo "chief approve: --note needs a value" >&2; exit 2; }
                note="$2"; shift 2 ;;
    -*)         echo "unknown flag: $1  (usage: chief approve [--list] [-m NOTE] [names…])" >&2; exit 2 ;;
    *)          names="$names $1"; shift ;;
  esac; done
  load_project
  # shellcheck disable=SC1091
  source "$ENGINE/zones.sh"
  # live.sh only defines functions; used to keep the liveliness record in step with
  # the state file re-armed above. Missing (older install) -> silently skipped.
  # shellcheck disable=SC1091
  [ -f "$ENGINE/live.sh" ] && source "$ENGINE/live.sh"
  state="$CHIEF_PROJECT/$CHIEF_STATE_DIR/parallel"
  if [ "$list" = 1 ] || [ -z "$names" ]; then
    echo "chief approve — branches held at an overlap zone in $(basename "$CHIEF_PROJECT"):"
    for n in "$state"/*.zone-request.json; do
      [ -e "$n" ] || continue
      zones_show "$state" "$(basename "$n" .zone-request.json)"; found=1
    done
    [ "$found" = 0 ] && {
      echo "  = nothing is awaiting approval"
      echo "    (a repo declares its zones in .chief/zones.conf — docs/reference/overlap-zones.md)"; }
    exit 0
  fi
  for n in $names; do zones_approve "$state" "$n" "$note" || rc=1; done
  exit "$rc"
}

# ── operator decision verdicts (the only path that may make this transition) ──
cmd_decide() {
  local name="" verdict="" note="" action="" superseded="" f rec tmp deps="" n
  [ "$#" -ge 1 ] || { echo "usage: chief decide NAME VERDICT --note NOTE (--retire ID|--unpark)" >&2; return 2; }
  name="${1%.json}"; shift
  case "${1:-}" in
    --verdict|-v) [ "$#" -ge 2 ] || { echo "chief decide: --verdict needs a value" >&2; return 2; }; verdict="$2"; shift 2 ;;
    -*) ;;
    *) verdict="$1"; shift ;;
  esac
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -m|--note) [ "$#" -ge 2 ] || { echo "chief decide: --note needs a value" >&2; return 2; }; note="$2"; shift 2 ;;
      --retire) action=retire; shift; [ "$#" -gt 0 ] && [[ "$1" != -* ]] && { superseded="$1"; shift; } ;;
      --superseded-by) [ "$#" -ge 2 ] || { echo "chief decide: --superseded-by needs a value" >&2; return 2; }; superseded="$2"; shift 2 ;;
      --unpark) action=unpark; shift ;;
      -*) echo "chief decide: unknown option $1" >&2; return 2 ;;
      *) echo "chief decide: unexpected argument $1" >&2; return 2 ;;
    esac
  done
  [ -n "$verdict" ] || { echo "chief decide: a verdict is required" >&2; return 2; }
  [ -n "$note" ] || { echo "chief decide: --note is required" >&2; return 2; }
  [ -n "$action" ] || { echo "chief decide: choose --retire ID or --unpark" >&2; return 2; }
  [ "$action" != retire ] || [ -n "$superseded" ] || { echo "chief decide: --retire requires an ID" >&2; return 2; }
  load_project
  . "$ENGINE/decision.sh"
  f="$CHIEF_PROJECT/$CHIEF_TASKS_DIR/$name.json"
  [ -f "$f" ] || { echo "chief decide: no live tasklist '$name'" >&2; return 1; }
  is_decision_tasklist "$f" || { echo "chief decide: '$name' is not a DECISION tasklist" >&2; return 1; }
  if [ "$action" = retire ]; then
    for n in "$CHIEF_PROJECT/$CHIEF_TASKS_DIR"/*.json; do
      [ -f "$n" ] || continue
      [ "$(basename "$n" .json)" = "$name" ] && continue
      if jq -e --arg d "$name" '(.dependsOn // []) | any(. == $d)' "$n" >/dev/null 2>&1; then deps="$deps $(basename "$n" .json)"; fi
    done
    [ -z "$deps" ] || { echo "chief decide: refusing retirement of '$name'; live dependents:$deps" >&2; return 1; }
  fi
  tmp="${f}.decide.$$"
  jq --arg choice "$verdict" --arg reason "$note" --arg action "$action" --arg superseded "$superseded" \
    '.verdict={choice:$choice,note:$reason,recordedAt:(now|todateiso8601)} |
     if $action == "unpark" then (.parked=false | del(.parkedReason)) else (.supersededBy=$superseded) end' \
    "$f" > "$tmp" || { rm -f "$tmp"; echo "chief decide: invalid tasklist JSON" >&2; return 1; }
  mv "$tmp" "$f"
  if [ "$action" = retire ]; then
    rec="$CHIEF_PROJECT/$CHIEF_TASKS_DIR/completed/$name.json"
    mkdir -p "$(dirname "$rec")"; mv "$f" "$rec"
    echo "✓ $name retired in completed/ (supersededBy=$superseded; no mergedToMain)"
  else
    echo "✓ $name unparked with verdict '$verdict'"
  fi
  . "$ENGINE/events.sh"
  CHIEF_EVENTS_FILE="${CHIEF_RUNS}/decisions.events.jsonl" CHIEF_EVENT_REPO="$CHIEF_PROJECT" \
    event_emit "tasklist.decision" name="$name" state="$action" detail="$verdict — $note"
}

# ── operator pause / resume (the human's quota lever) ────────────────────────
# The pause is a FLAG FILE under a repo's scheduler state — <state>/parallel/.paused —
# polled by the driver's launch gate and by agent.sh's iteration boundary (see the
# OPERATOR PAUSE block in engine/driver.sh). Arming it withholds AGENT TURNS: no
# tasklist launches and no new iteration starts. It DRAINS rather than kills — the
# iteration in flight always runs to completion so its commits land, and a tasklist
# whose agent loop already finished still verifies and merges (finishing that is
# agent-free, and parking it would strand a finished branch and its dependents).
# Drained tasklists park in state `paused` keeping branch AND worktree, so the next
# run RESUMEs each from its committed passes state.
#
# Kept strictly apart from the USAGE-LIMIT window (<state>/parallel/.limit-pause-until):
# that one is an account-wide deadline Chief waits out and lifts by itself. Neither
# command below ever reads or writes it, and neither touches <name>.retries — spending
# the usage-limit re-dispatch budget on a human's decision would let a few manual
# pauses silently exhaust the self-heal.
pause_dir_of()  { printf '%s/parallel' "$1"; }              # $1 = a repo's state root
pause_file_of() { printf '%s/parallel/.paused' "$1"; }
run_field()     { sed -n "s/^$1=//p" "$2" 2>/dev/null | head -1; }   # monitor.sh's field()
stamp_at()      { date -r "$1" '+%H:%M' 2>/dev/null || date -d "@$1" '+%H:%M' 2>/dev/null || echo "$1"; }

# Tasklists under state root $1 whose coarse scheduler state is exactly $2.
states_matching() {
  local f
  for f in "$1"/parallel/*.state; do
    [ -e "$f" ] || continue
    [ "$(cat "$f" 2>/dev/null)" = "$2" ] || continue
    printf '%s ' "$(basename "$f" .state)"
  done
  return 0
}

pause_one() {   # $1 = state root, $2 = label
  local pf since running
  pf="$(pause_file_of "$1")"
  if [ -f "$pf" ]; then
    since="$(cat "$pf" 2>/dev/null || echo)"
    case "$since" in ''|*[!0-9]*) since="" ;; esac
    echo "  = $2 is already paused${since:+ (since ~$(stamp_at "$since"))} — nothing to do"
    return 0
  fi
  # An idle repo may never have had a run: only the driver creates parallel/.
  mkdir -p "$(pause_dir_of "$1")" 2>/dev/null \
    || { echo "chief pause: cannot create $(pause_dir_of "$1")" >&2; return 1; }
  # The stamp is informational (the monitor dates the hold); PRESENCE is the gate.
  date +%s > "$pf" 2>/dev/null || { echo "chief pause: cannot write $pf" >&2; return 1; }
  echo "  ⏸ $2 PAUSED — no tasklist launches, no new agent iteration starts"
  running="$(states_matching "$1" running)"
  if [ -n "$running" ]; then
    echo "     draining: ${running% } — the iteration in flight finishes and its commits land;"
    echo "     a tasklist whose agent loop is already done still verifies + merges, then parks."
  fi
  return 0
}

resume_one() {  # $1 = state root, $2 = label
  local pf lifted=0 parked="" f n limit
  pf="$(pause_file_of "$1")"
  if [ -f "$pf" ]; then
    rm -f "$pf" 2>/dev/null || { echo "chief resume: cannot remove $pf" >&2; return 1; }
    lifted=1
  fi
  # Re-arm what the drain parked: `paused` -> `pending`, so the next `chief run`
  # RESUMEs each branch from its committed passes state with nothing rebuilt. The
  # state files outlive the run, so this works with no driver alive.
  for f in "$1"/parallel/*.state; do
    [ -e "$f" ] || continue
    [ "$(cat "$f" 2>/dev/null)" = paused ] || continue
    n="$(basename "$f" .state)"
    printf 'pending' > "$f" 2>/dev/null || continue
    command -v live_set >/dev/null 2>&1 && live_set "$1/parallel/$n.live.json" name="$n" state=pending phase=resumed
    parked="$parked $n"
  done
  if [ "$lifted" = 0 ] && [ -z "$parked" ]; then
    echo "  = $2 is not paused — nothing to resume"
    return 0
  fi
  if [ "$lifted" = 1 ]; then echo "  ▶ $2 RESUMED — the operator pause is lifted"
  else                       echo "  ▶ $2 was not paused, but had tasklists parked from an earlier pause"; fi
  [ -n "$parked" ] && echo "     re-armed as pending:$parked — 'chief run' picks each up from its committed passes state"
  # A usage-limit window is a DIFFERENT hold with its own lifetime: resume lifts the
  # human's decision only, never the account's.
  limit="$(cat "$1/parallel/.limit-pause-until" 2>/dev/null || echo)"
  case "$limit" in ''|*[!0-9]*) limit="" ;; esac
  [ -n "$limit" ] && [ "$limit" -gt "$(date +%s)" ] \
    && echo "     note: a usage-limit window is still armed until ~$(stamp_at "$limit") — the run waits that one out itself"
  return 0
}

apply_one() {   # $1 = pause|resume, $2 = state root, $3 = label
  case "$1" in
    pause) pause_one  "$2" "$3" ;;
    *)     resume_one "$2" "$3" ;;
  esac
}

# Both commands are idempotent, exit 0 on a no-op, and work whether or not a run is
# live: pausing an idle repo PRE-ARMS it, and `chief run` on a pre-armed repo reports
# the pause instead of launching. `--all` arms every run in the host-wide registry —
# concurrent runs across sibling repos share one account, so the quota decision is
# usually fleet-wide rather than per-repo.
cmd_pause_resume() {
  local verb="$1"; shift
  local all=0 rc=0
  while [ "$#" -gt 0 ]; do case "$1" in
    -a|--all) all=1; shift ;;
    -*)       echo "unknown flag: $1  (usage: chief $verb [--all])" >&2; exit 2 ;;
    *)        echo "chief $verb takes no arguments  (usage: chief $verb [--all])" >&2; exit 2 ;;
  esac; done
  # live.sh only defines functions; resume uses it to keep the liveliness record in
  # step with the state file it re-arms. Missing (older install) -> silently skipped.
  # shellcheck disable=SC1091
  [ "$verb" = resume ] && [ -f "$ENGINE/live.sh" ] && source "$ENGINE/live.sh"

  if [ "$all" = 1 ]; then
    local f repo st pid live seen="" n=0
    echo "chief $verb --all — every run registered in $CHIEF_RUNS:"
    for f in "$CHIEF_RUNS"/*.run; do
      [ -e "$f" ] || continue
      repo="$(run_field repo "$f")"; st="$(run_field state "$f")"; pid="$(run_field pid "$f")"
      [ -n "$st" ] || { [ -n "$repo" ] && st="$repo/.chief/state"; }
      [ -n "$st" ] || continue
      case " $seen " in *" $st "*) continue ;; esac    # one repo, many run files
      seen="$seen $st"
      # A dead pid's record is a run that already exited; arming its repo is still
      # the right move (it pre-arms the next run), so say which it is rather than skip.
      if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then live=" (live run pid $pid)"; else live=" (no live run)"; fi
      apply_one "$verb" "$st" "$(basename "${repo:-$st}")$live" || rc=1
      n=$(( n + 1 ))
    done
    if [ "$n" = 0 ]; then
      echo "  = no runs registered — nothing to $verb"
      echo "    (run 'chief $verb' from inside a repo — it works with no run active too)"
    fi
    exit "$rc"
  fi

  load_project
  apply_one "$verb" "$CHIEF_PROJECT/$CHIEF_STATE_DIR" "$(basename "$CHIEF_PROJECT")" || rc=1
  exit "$rc"
}

cmd_update() {
  if [ ! -d "$SELF/.git" ]; then
    echo "chief: $SELF is not a git checkout — reinstall with the install.sh one-liner instead." >&2
    exit 1
  fi
  local ver="${CHIEF_VERSION:-main}" before after target beforeroot afterroot
  before="$(git -C "$SELF" rev-parse --short HEAD 2>/dev/null || echo '?')"
  beforeroot="$(git -C "$SELF" rev-list --max-parents=0 HEAD 2>/dev/null | tail -1)"
  echo "→ updating chief in $SELF (${ver})"
  git -C "$SELF" fetch --quiet --tags --force origin || { echo "chief: 'git fetch' failed (offline?)." >&2; exit 1; }
  # Resolve $ver to a concrete target: a branch on origin, else a tag/sha of that name.
  if   git -C "$SELF" rev-parse --verify --quiet "origin/$ver" >/dev/null 2>&1; then target="origin/$ver"
  elif git -C "$SELF" rev-parse --verify --quiet "$ver"        >/dev/null 2>&1; then target="$ver"
  else echo "chief: '$ver' is not a branch or tag on origin." >&2; exit 1; fi
  # Track the remote EXACTLY (hard-reset, not ff-only): the install prefix keeps no
  # local commits, and a re-rooted / force-pushed history cannot be fast-forwarded —
  # that silent failure is what froze installs on a stale version. Reset crosses it.
  git -C "$SELF" reset --hard --quiet "$target" || { echo "chief: 'git reset' to $target failed." >&2; exit 1; }
  chmod +x "$SELF/bin/chief" "$SELF/engine/"*.sh 2>/dev/null || true
  after="$(git -C "$SELF" rev-parse --short HEAD 2>/dev/null || echo '?')"
  afterroot="$(git -C "$SELF" rev-list --max-parents=0 HEAD 2>/dev/null | tail -1)"
  if [ "$before" = "$after" ]; then echo "✓ already up to date — chief $(cat "$SELF/VERSION" 2>/dev/null || echo '?') ($after)"
  elif [ -n "$beforeroot" ] && [ "$beforeroot" != "$afterroot" ]; then
    echo "✓ updated chief $before → $(cat "$SELF/VERSION" 2>/dev/null || echo '?') ($after) — reset across a re-rooted history"
  else echo "✓ updated chief $before → $(cat "$SELF/VERSION" 2>/dev/null || echo '?') ($after)"; fi
}

cmd="${1:-help}"; shift 2>/dev/null || true
case "$cmd" in
  init)                 cmd_init ;;
  run)                  cmd_run "$@" ;;
  list)                 cmd_list "$@" ;;
  status)               cmd_status "$@" ;;
  lint)                 cmd_lint "$@" ;;
  gen|generate)         cmd_gen "$@" ;;
  ps)                   cmd_ps "$@" ;;
  monitor|watch)        cmd_monitor "$@" ;;
  logs|tail)            cmd_logs "$@" ;;
  events|subscribe)     cmd_events "$@" ;;
  usage)                 cmd_usage "$@" ;;
  models)               cmd_models "$@" ;;
  reap)                 cmd_reap "$@" ;;
  quality)              cmd_quality "$@" ;;
  cigate)               cmd_cigate "$@" ;;
  retire)               cmd_retire "$@" ;;
  approve)              cmd_approve "$@" ;;
  decide)               cmd_decide "$@" ;;
  pause)                cmd_pause_resume pause "$@" ;;
  resume)               cmd_pause_resume resume "$@" ;;
  version|-v|--version) echo "chief $VERSION" ;;
  update)               cmd_update ;;
  help|-h|--help)       usage ;;
  *)                    echo "unknown command: $cmd" >&2; usage; exit 2 ;;
esac
